# ==============================================================================
# AegisLedger - Unified Global Environment Configuration Template
# Mẫu cấu hình biến môi trường duy nhất cho toàn bộ hệ thống Monorepo & Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Datastore & Logical Replication (WORM Engine)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_secure_password_2026
POSTGRES_DB=aegis_ledger_db
DATABASE_URL="postgresql://aegis_admin:aegis_secure_password_2026@localhost:5432/aegis_ledger_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Redis (Fast State Cache & Active Defense Lock)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aegis_redis_pass_2026
ACTIVE_DEFENSE_LOCK_KEY=AEGIS:ACTIVE_DEFENSE:LOCK_WITHDRAWALS

# ------------------------------------------------------------------------------
# 3. Apache Kafka KRaft (Distributed Message Streaming)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_CLIENT_ID=aegis-ledger
KAFKA_CLUSTER_ID=4L622nShTUiTvyYzk0wh5w

# ------------------------------------------------------------------------------
# 4. Telegram Alert Bot (Autonomous Active Defense Notifications)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ------------------------------------------------------------------------------
# 5. Microservices Networking Ports
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3333
WALLET_PORT=4000
