{
  "name": "@aegis-ledger-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "docker:up": "docker compose -f tools/docker/docker-compose.yml --env-file tools/docker/.env up -d",
    "docker:down": "docker compose -f tools/docker/docker-compose.yml --env-file tools/docker/.env down",
    "docker:postgres": "docker compose -f tools/docker/docker-compose.postgres.yml --env-file tools/docker/.env up -d",
    "docker:redis": "docker compose -f tools/docker/docker-compose.redis.yml --env-file tools/docker/.env up -d",
    "docker:kafka": "docker compose -f tools/docker/docker-compose.kafka.yml --env-file tools/docker/.env up -d",
    "docker:status": "docker compose -f tools/docker/docker-compose.yml ps",
    "test:contracts": "jest --config libs/contracts/jest.config.js",
    "test:crypto": "jest --config libs/crypto-core/jest.config.js",
    "test:database": "jest --config libs/database/jest.config.js --runInBand",
    "test:event-bus": "jest --config libs/event-bus/jest.config.js",
    "test:audit-ledger": "jest --config apps/audit-ledger/jest.config.js --runInBand",
    "test:wallet-core": "jest --config apps/wallet-core/jest.config.js --runInBand",
    "test:tamper-watcher": "jest --config apps/tamper-watcher/jest.config.js --runInBand",
    "test:audit-cli": "jest --config apps/audit-cli/jest.config.js --runInBand",
    "test:dashboard": "jest --config apps/audit-dashboard/jest.config.js --runInBand",
    "dashboard": "ts-node -r tsconfig-paths/register apps/audit-dashboard/src/main.ts",
    "audit-cli": "ts-node -r tsconfig-paths/register apps/audit-cli/src/cli.ts",
    "db:push": "prisma db push --schema=libs/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=libs/database/prisma/schema.prisma"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@nx/js": "^23.3.0",
    "@nx/nest": "^23.3.0",
    "@nx/node": "^23.3.0",
    "@nx/workspace": "23.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "nx": "23.3.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "@types/ioredis": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^15.0.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
